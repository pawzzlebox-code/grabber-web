{
  "manifest_version": 3,
  "name": "Grabber Helper",
  "description": "One-click video downloads via Grabber",
  "version": "1.0.0",
  "permissions": ["cookies", "activeTab", "contextMenus", "storage"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.youtu.be/*", "*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.vimeo.com/*", "*://*.reddit.com/*", "*://*.twitch.tv/*", "*://*.facebook.com/*", "*://*.dailymotion.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grabber — Download this video"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
